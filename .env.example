API_PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=

# Google Identity Services OAuth Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Comma-separated operator emails
VITE_OPERATOR_EMAILS=operator@example.com

# Xaman Platform API credentials
XAMAN_API_KEY=
XAMAN_API_SECRET=

# Optional AI integration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# XRPL Testnet settings
XRPL_NETWORK=testnet
XRPL_TESTNET_WS=wss://s.altnet.rippletest.net:51233
XRPL_TESTNET_WSS=wss://s.altnet.rippletest.net:51233
XRPL_TESTNET_DONATION_DESTINATION=
XRPL_TESTNET_GOVERNANCE_DESTINATION=
XRPL_TESTNET_RLUSD_CURRENCY=RLUSD
XRPL_TESTNET_RLUSD_ISSUER=
XRPL_TESTNET_RLUSD_ISSUER_ADDRESS=
XRPL_TESTNET_RLUSD_ISSUER_SEED=
XRPL_TESTNET_USDC_CURRENCY=USDC
XRPL_TESTNET_USDC_ISSUER=
XRPL_TESTNET_USDC_ISSUER_ADDRESS=
XRPL_TESTNET_USDC_ISSUER_SEED=
XRPL_TESTNET_CREDENTIAL_ISSUER_ADDRESS=
XRPL_TESTNET_CREDENTIAL_ISSUER_SEED=

ADMIN_FAUCET_ENABLED=true
ADMIN_SECRET=

# Database URL
DATABASE_URL=postgresql://postgres:password@host:port/database
